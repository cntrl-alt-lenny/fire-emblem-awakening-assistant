    {
      "id": "attack",
      "name": "Displayed attack",
      "value": "strength_or_magic + weapon_might + weapon_rank_attack_bonus",
      "source_ids": [
        "calculations"
      ],
      "verification": "single_source_reviewed",
      "notes": "Use effective displayed stats. Triangle is applied to damage separately; effectiveness changes weapon might."
    },
    {
      "id": "damage",
      "name": "Damage",
      "value": "max(0, attack + triangle_attack - defense_or_resistance - terrain_defense_or_resistance)",
